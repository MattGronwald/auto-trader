# Copy to `.env` (git-ignored) and fill in. Real environment variables override `.env`.
# Never commit real keys. Paper and live use separate key pairs; live keys never go on the laptop.

# Alpaca — paper account keys (required from WP 0.7)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# Anthropic (required from Phase 2)
ANTHROPIC_API_KEY=

# Dashboard bearer token (required from Phase 3)
DASHBOARD_TOKEN=
